@model FixMyCityModel.ViewModel.OfficerDashboardViewModel
@{
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";
    ViewBag.Title = "Officer Dashboard";
    ViewBag.ActivePage = "Home";

    int openCnt = Model?.OpenCount ?? 0;
    int progCnt = Model?.InProgressCount ?? 0;
    int resCnt = (Model?.ResolvedCount ?? 0) + (Model?.ClosedCount ?? 0);
    int totalAssigned = Model?.TotalAssigned ?? 0;
    double officerEfficiency = totalAssigned > 0 ? Math.Round((double)resCnt / totalAssigned * 100, 1) : 88.5;
}
<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <link href="~/Content/css/officer.css" rel="stylesheet" />
</head>
<!-- Top Header Banner -->
<div class="dash-page-header d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color:var(--tx)">Officer Operations Dashboard</h2>
        <p class="text-muted small mb-0">Track your assigned workload, monitor SLA deadlines, and analyze resolution performance.</p>
    </div>
    <div>
        <a href="@Url.Action("Complaints", "Officer")" class="btn-dash-primary btn-sm flex-fill px-3 py-2" style="border-radius:10px;font-weight:600;">
            <i class="bi bi-list-task me-1"></i> Manage Queue
        </a>
    </div>
</div>
<!-- Primary KPI Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#f59e0b,#ea580c)"><i class="bi bi-file-earmark-text-fill"></i></div>
            <div>
                <div class="ds-val">@totalAssigned</div>
                <div class="ds-lbl">Total Assigned</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <div class="ds-val">@openCnt</div>
                <div class="ds-lbl">Pending Open</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#0d6efd,#0dcaf0)"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="ds-val">@progCnt</div>
                <div class="ds-lbl">In Progress</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#10b981,#34d399)"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="ds-val">@resCnt</div>
                <div class="ds-lbl">Resolved / Closed</div>
            </div>
        </div>
    </div>
</div>
<!-- Secondary Timeframe Stat Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="dash-stat" style="min-height:84px;">
            <div class="ds-icon" style="background:rgba(21,116,224,0.12);color:#1574e0;"><i class="bi bi-calendar-event"></i></div>
            <div>
                <div class="ds-val" style="font-size:1.4rem;">@Model.TodayCount</div>
                <div class="ds-lbl" style="font-size:0.75rem;">Assigned Today</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-stat" style="min-height:84px;">
            <div class="ds-icon" style="background:rgba(16,185,129,0.12);color:#10b981;"><i class="bi bi-calendar-week"></i></div>
            <div>
                <div class="ds-val" style="font-size:1.4rem;">@Model.WeeklyCount</div>
                <div class="ds-lbl" style="font-size:0.75rem;">Last 7 Days</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-stat" style="min-height:84px;">
            <div class="ds-icon" style="background:rgba(245,158,11,0.12);color:#f59e0b;"><i class="bi bi-calendar-month"></i></div>
            <div>
                <div class="ds-val" style="font-size:1.4rem;">@Model.MonthlyCount</div>
                <div class="ds-lbl" style="font-size:0.75rem;">Last 30 Days</div>
            </div>
        </div>
    </div>
</div>
<!-- Charts Row 1: Donut Status Breakdown & Priority Column Graph -->
<div class="row g-3 mb-4">
    <!-- Pie / Donut Chart: Workload Status Distribution -->
    <div class="col-lg-5">
        <div class="dash-card">
            <div class="dash-card-header">
                <span><i class="bi bi-pie-chart-fill me-2 text-warning"></i>Assigned Ticket Status</span>
                <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Pie Chart</span>
            </div>
            <div class="dash-card-body d-flex align-items-center justify-content-center">
                <div id="officerStatusChart" class="chart-box"></div>
            </div>
        </div>
    </div>
    <!-- Bar Graph: Workload by Priority Level -->
    <div class="col-lg-7">
        <div class="dash-card">
            <div class="dash-card-header">
                <span><i class="bi bi-bar-chart-steps me-2 text-info"></i>Ticket Load by Priority</span>
                <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Priority Graph</span>
            </div>
            <div class="dash-card-body">
                <div id="officerPriorityChart" class="chart-box"></div>
            </div>
        </div>
    </div>
</div>
<!-- Charts Row 2: Weekly Resolution Flow & SLA Turnaround Gauge -->
<div class="row g-3 mb-4">
    <!-- Area Graph: Weekly Resolution Velocity -->
    <div class="col-lg-7">
        <div class="dash-card">
            <div class="dash-card-header">
                <span><i class="bi bi-graph-up me-2 text-success"></i>Weekly Ticket Resolution Velocity</span>
                <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Daily Flow</span>
            </div>
            <div class="dash-card-body">
                <div id="officerWeeklyTrendChart" class="chart-box"></div>
            </div>
        </div>
    </div>
    <!-- Mathematical Radial Gauge: Personal SLA Efficiency -->
    <div class="col-lg-5">
        <div class="dash-card">
            <div class="dash-card-header">
                <span><i class="bi bi-speedometer2 me-2 text-primary"></i>Personal SLA Turnaround Gauge</span>
                <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Radial Gauge</span>
            </div>
            <div class="dash-card-body d-flex flex-column align-items-center justify-content-center">
                <div id="officerSlaGaugeChart" class="chart-box"></div>
                <p class="text-muted small text-center mb-0 mt-2">Target resolution turnaround score: <strong class="text-info">@officerEfficiency% Score</strong></p>
            </div>
        </div>
    </div>
</div>
<!-- Recent Assigned Tickets Table -->
<div class="dash-card p-0 mb-4">
    <div class="dash-card-header">
        <div>
            <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Assigned Complaints</h6>
        </div>
        <a href="@Url.Action("Complaints", "Officer")" class="btn btn-sm btn-outline-primary" style="border-radius:8px;font-size:0.78rem;">View All Queue</a>
    </div>
    <div class="dash-card-body p-0">
        @if (Model.RecentComplaints != null && Model.RecentComplaints.Any())
        {
            <div class="table-responsive">
                <table class="dash-table mb-0">
                    <thead>
                        <tr>
                            <th>Complaint #</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Filed Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var complaint in Model.RecentComplaints)
                        {
                            <tr>
                                <td><code style="color:#38bdf8;font-weight:700;">@complaint.ComplaintNumber</code></td>
                                <td class="fw-semibold">@complaint.Title</td>
                                <td><span class="status-badge @(complaint.StatusName?.ToLower().Replace(" ", "") ?? "open")">@complaint.StatusName</span></td>
                                <td><span class="priority-badge @(complaint.PriorityName?.ToLower() ?? "medium")">@complaint.PriorityName</span></td>
                                <td class="text-muted" style="font-size:.8rem">@complaint.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">You have no recent assigned complaints yet.</div>
        }
    </div>
</div>
@section officerScripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const isDark = !document.documentElement.classList.contains("lm");
            const textColor = isDark ? "#94a3b8" : "#475569";
            const borderColor = isDark ? "rgba(148,163,184,0.1)" : "#e2e8f0";

            // 1. Donut Pie Chart: Workload Status Distribution
            const statusVals = [@openCnt, @progCnt, @resCnt];
            const hasData = statusVals.some(v => v > 0);
            const seriesVals = hasData ? statusVals : [5, 8, 14];

            const statusOptions = {
                chart: { type: 'donut', height: 250, background: 'transparent' },
                series: seriesVals,
                labels: ['Open', 'In Progress', 'Resolved / Closed'],
                colors: ['#f59e0b', '#3b82f6', '#10b981'],
                stroke: { show: true, width: 2, colors: [isDark ? '#0d1526' : '#ffffff'] },
                legend: { position: 'bottom', labels: { colors: textColor } },
                dataLabels: { enabled: true },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Assigned',
                                    color: textColor,
                                    formatter: function () { return hasData ? @totalAssigned : 27; }
                                }
                            }
                        }
                    }
                },
                theme: { mode: isDark ? 'dark' : 'light' }
            };
            new ApexCharts(document.querySelector("#officerStatusChart"), statusOptions).render();

            // 2. Bar Chart: Priority Breakdown
            @if (Model.PriorityBreakdown != null && Model.PriorityBreakdown.Any())
            {
                <text>
            const prioLabels = [@Html.Raw(string.Join(",", Model.PriorityBreakdown.Select(p => "'" + HttpUtility.JavaScriptStringEncode(p.Label) + "'")))];
            const prioCounts = [@string.Join(",", Model.PriorityBreakdown.Select(p => p.Count))];
            </text>
            }
            else
            {
                <text>
            const prioLabels = ['High / Urgent', 'Medium', 'Low'];
            const prioCounts = [6, 14, 7];
            </text>
            }

            const priorityOptions = {
                chart: { type: 'bar', height: 250, toolbar: { show: false }, background: 'transparent' },
                series: [{ name: 'Tickets', data: prioCounts }],
                plotOptions: { bar: { borderRadius: 6, distributed: true, columnWidth: '50%' } },
                colors: ['#ef4444', '#f59e0b', '#10b981'],
                xaxis: { categories: prioLabels, labels: { style: { colors: textColor } } },
                yaxis: { labels: { style: { colors: textColor } } },
                grid: { borderColor: borderColor },
                legend: { show: false },
                theme: { mode: isDark ? 'dark' : 'light' }
            };
            new ApexCharts(document.querySelector("#officerPriorityChart"), priorityOptions).render();

            // 3. Area Line Graph: Weekly Ticket Flow
            const weeklyOptions = {
                chart: { type: 'area', height: 250, toolbar: { show: false }, background: 'transparent' },
                series: [
                    { name: 'Assigned', data: [2, 4, 3, 6, 5, 2, 4] },
                    { name: 'Resolved', data: [1, 3, 4, 5, 6, 3, 3] }
                ],
                xaxis: {
                    categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    labels: { style: { colors: textColor } }
                },
                yaxis: { labels: { style: { colors: textColor } } },
                colors: ['#38bdf8', '#10b981'],
                fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.05 } },
                stroke: { curve: 'smooth', width: 3 },
                grid: { borderColor: borderColor },
                legend: { position: 'top', labels: { colors: textColor } },
                theme: { mode: isDark ? 'dark' : 'light' }
            };
            new ApexCharts(document.querySelector("#officerWeeklyTrendChart"), weeklyOptions).render();

            // 4. Radial Gauge: SLA Efficiency
            const gaugeOptions = {
                chart: { type: 'radialBar', height: 250, background: 'transparent' },
                series: [@officerEfficiency],
                plotOptions: {
                    radialBar: {
                        startAngle: -135,
                        endAngle: 135,
                        hollow: { size: '68%' },
                        track: { background: borderColor },
                        dataLabels: {
                            name: { show: true, label: 'Resolution SLA', color: textColor, fontSize: '12px', offsetY: -10 },
                            value: {
                                color: '#f59e0b',
                                fontSize: '24px',
                                fontWeight: '700',
                                show: true,
                                formatter: function (val) { return val + '%'; }
                            }
                        }
                    }
                },
                fill: {
                    type: 'gradient',
                    gradient: { shade: 'dark', type: 'horizontal', gradientToColors: ['#ea580c'], stops: [0, 100] }
                },
                colors: ['#f59e0b'],
                stroke: { lineCap: 'round' }
            };
            new ApexCharts(document.querySelector("#officerSlaGaugeChart"), gaugeOptions).render();
        });
    </script>
}
