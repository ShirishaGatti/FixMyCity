@model FixMyCityModel.ViewModel.OfficerDashboardViewModel
@{
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";
    ViewBag.Title = "Officer Dashboard";
    ViewBag.ActivePage = "Home";
}

<div class="dash-page-header d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
    <div>
        <h1>Officer Dashboard</h1>
        <p>Review your assigned complaints, track priorities, and stay ahead of resolution deadlines.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#1574e0,#38bdf8)"><i class="bi bi-file-earmark-text-fill"></i></div>
            <div>
                <div class="ds-val">@Model.TotalAssigned</div>
                <div class="ds-lbl">Total Assigned</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-file-earmark-exclamation-fill"></i></div>
            <div>
                <div class="ds-val">@Model.OpenCount</div>
                <div class="ds-lbl">Open</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#0d6efd,#0dcaf0)"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="ds-val">@Model.InProgressCount</div>
                <div class="ds-lbl">In Progress</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#10b981,#34d399)"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="ds-val">@(Model.ResolvedCount + Model.ClosedCount)</div>
                <div class="ds-lbl">Resolved / Closed</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="dash-stat" style="min-height:92px;">
            <div class="ds-icon" style="background:rgba(21,116,224,0.12);color:#1574e0;"><i class="bi bi-calendar-event"></i></div>
            <div>
                <div class="ds-val" style="font-size:1.5rem;">@Model.TodayCount</div>
                <div class="ds-lbl" style="font-size:0.75rem;">Assigned Today</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-stat" style="min-height:92px;">
            <div class="ds-icon" style="background:rgba(16,185,129,0.12);color:#10b981;"><i class="bi bi-calendar-week"></i></div>
            <div>
                <div class="ds-val" style="font-size:1.5rem;">@Model.WeeklyCount</div>
                <div class="ds-lbl" style="font-size:0.75rem;">Last 7 Days</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-stat" style="min-height:92px;">
            <div class="ds-icon" style="background:rgba(245,158,11,0.12);color:#f59e0b;"><i class="bi bi-calendar-month"></i></div>
            <div>
                <div class="ds-val" style="font-size:1.5rem;">@Model.MonthlyCount</div>
                <div class="ds-lbl" style="font-size:0.75rem;">Last 30 Days</div>
            </div>
        </div>
    </div>
</div>

<div class="dash-card mt-4 p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-0">Complaints by Priority</h5>
            <p class="text-muted small mb-0">Quick breakdown of your current workload.</p>
        </div>
    </div>
    @if (Model.PriorityBreakdown.Any())
    {
        <div class="row g-3">
            @foreach (var item in Model.PriorityBreakdown)
            {
                <div class="col-sm-4">
                    <div class="p-3 rounded-3" style="background:rgba(255,255,255,.08);">
                        <h6 class="mb-2">@item.Label</h6>
                        <p class="fs-3 mb-0">@item.Count</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">No assigned complaints yet.</div>
    }
</div>

<div class="dash-card mt-4 p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-0">Recent Assigned Complaints</h5>
            <p class="text-muted small mb-0">Most recent tickets assigned to you.</p>
        </div>
        <a href="@Url.Action("Complaints", "Officer")" class="btn btn-sm btn-outline-primary">View all</a>
    </div>
    @if (Model.RecentComplaints.Any())
    {
        <div class="table-responsive">
            <table class="dash-table mb-0">
                <thead>
                    <tr>
                        <th>Complaint #</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Filed On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var complaint in Model.RecentComplaints)
                    {
                        <tr>
                            <td class="complaint-num">@complaint.ComplaintNumber</td>
                            <td>@complaint.Title</td>
                            <td><span class="status-badge @complaint.StatusName.ToLower().Replace(" ", "")">@complaint.StatusName</span></td>
                            <td><span class="priority-badge @complaint.PriorityName.ToLower()">@complaint.PriorityName</span></td>
                            <td>@complaint.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">You have no recent assigned complaints yet.</div>
    }
</div>
