@model FixMyCityModel.ViewModel.MyComplaintsViewModel
@{
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";
    ViewBag.Title = "Assigned Complaints";
    ViewBag.ActivePage = "Complaints";
}

<div class="dash-page-header d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
    <div>
        <h1>Assigned Complaints</h1>
        <p>Search, sort, and manage the complaints assigned to you without reloading the page.</p>
    </div>
</div>

<div class="dash-card mb-4" style="padding:18px 20px;">
    <div class="row g-2 align-items-end">

        <div class="col-md">
            <label class="dash-label">Search</label>
            <input id="searchTerm" type="search" class="dash-input"
                   placeholder="Number, title, category..." value="@Model.SearchTerm" />
        </div>

        <div class="col-md-2">
            <label class="dash-label">Status</label>
            <select id="statusFilter" class="dash-input">
                <option value="">All Statuses</option>
                @foreach (var status in Model.Statuses)
                {
                    <option value="@status.StatusId" @(Model.StatusId == status.StatusId ? "selected" : "")>@status.StatusName</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="dash-label">Priority</label>
            <select id="priorityFilter" class="dash-input">
                <option value="">All Priorities</option>
                @foreach (var priority in Model.Priorities)
                {
                    <option value="@priority.PriorityId" @(Model.PriorityId == priority.PriorityId ? "selected" : "")>@priority.PriorityName</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="dash-label">Category</label>
            <select id="categoryFilter" class="dash-input">
                <option value="">All Categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CategoryId" @(Model.CategoryId == category.CategoryId ? "selected" : "")>@category.CategoryName</option>
                }
            </select>
        </div>

        <div class="col-md-1">
            <label class="dash-label">Page</label>
            <input type="number" id="pageNumberFilter" class="dash-input" min="1" value="@Model.CurrentPage" />
        </div>

        <div class="col-md-1">
            <label class="dash-label">Rows</label>
            <select id="pageSizeFilter" class="dash-input">
                <option value="5"  @(Model.PageSize == 5  ? "selected" : "")>5</option>
                <option value="10" @(Model.PageSize == 10 ? "selected" : "")>10</option>
                <option value="20" @(Model.PageSize == 20 ? "selected" : "")>20</option>
                <option value="50" @(Model.PageSize == 50 ? "selected" : "")>50</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-1 align-items-end">
            <button type="button" id="applyFiltersBtn" class="btn-dash-primary btn-sm flex-fill">
                <i class="bi bi-search"></i> Search
            </button>
            <button type="button" id="clearFiltersBtn" class="btn-dash-outline btn-sm" title="Clear filters">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

    </div>
</div>

<div id="complaintsContainer">
    @Html.Partial("_OfficerComplaintTable", Model)
</div>

<div class="dash-card p-3 mt-4">
    <p class="text-muted small mb-0">Set your filters, then click Search or press Enter to apply them.</p>
</div>

<!-- ── Edit modal ─────────────────────────────────────────────
     Fields here match Officer/UpdateComplaint(complaintId, categoryId,
     priorityId, statusId) exactly — no Remarks/ResolutionNotes, no
     AssignedTo (that's admin-only). Values are populated from the row's
     data-* attributes when Edit is clicked, so no extra round trip. -->
<div class="dash-modal-overlay" id="editComplaintModal" style="display:none;">
    <div class="dash-modal" onclick="event.stopPropagation()">
        <div class="dash-modal-header">
            <h5>Edit Complaint  <span id="editComplaintNumberLabel"></span></h5>
            <button type="button" class="dash-modal-close" onclick="closeEditModal()">&times;</button>
        </div>
        <div class="dash-modal-body">
            @using (Html.BeginForm("UpdateComplaint", "Officer", FormMethod.Post, new { id = "editComplaintForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="editComplaintId" name="complaintId" />

                <div class="dash-form-group">
                    <label class="dash-label">Title</label>
                    <input type="text" id="editComplaintTitle" class="dash-input" readonly style="opacity:0.7;" />
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-4 dash-form-group">
                        <label class="dash-label">Category</label>
                        <select id="editCategoryId" name="categoryId" class="dash-input" required>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 dash-form-group">
                        <label class="dash-label">Priority</label>
                        <select id="editPriorityId" name="priorityId" class="dash-input" required>
                            @foreach (var priority in Model.Priorities)
                            {
                                <option value="@priority.PriorityId">@priority.PriorityName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 dash-form-group">
                        <label class="dash-label">Status</label>
                        <select id="editStatusId" name="statusId" class="dash-input" required>
                            @foreach (var status in Model.Statuses)
                            {
                                <option value="@status.StatusId">@status.StatusName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="dash-modal-footer">
                    <button type="button" class="btn-dash-outline" onclick="closeEditModal()">Cancel</button>
                    <button type="submit" class="btn-dash-primary" id="updateComplaintBtn">
                        <span class="spinner-border spinner-border-sm d-none" id="updateComplaintSpinner"></span>
                        Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- ── Chat modal ────────────────────────────────────────── -->
<div class="dash-modal-overlay" id="chatModal" style="display:none;" onclick="closeChatModal()">
    <div class="dash-modal" onclick="event.stopPropagation()" style="width:620px;">
        <div class="dash-modal-header">
            <h5><i class="bi bi-chat-dots-fill me-2" style="color:#1574e0;"></i>Discussion <span id="chatModalNumberLabel"></span></h5>
            <button type="button" class="dash-modal-close" onclick="closeChatModal()">&times;</button>
        </div>
        <div class="dash-modal-body" id="chatModalBody" style="padding:16px 20px; overflow-y:auto; max-height:520px;">
            <div class="text-center py-5"><span class="spinner-border"></span></div>
        </div>
    </div>
</div>

@section officerScripts {
    <script>
        var currentSortColumn = '@Model.SortColumn';
        var currentSortDirection = '@Model.SortDirection';
        var currentPage = @Model.CurrentPage;

        function gatherOfficerFilters() {
            return {
                SearchTerm: $('#searchTerm').val(),
                StatusId: $('#statusFilter').val(),
                PriorityId: $('#priorityFilter').val(),
                CategoryId: $('#categoryFilter').val(),
                SortColumn: currentSortColumn,
                SortDirection: currentSortDirection,
                PageSize: $('#pageSizeFilter').val()
            };
        }

        function updateSortIndicators() {
            $('.complaint-sort').removeClass('sorted-asc sorted-desc');
            $('.complaint-sort[data-sort="' + currentSortColumn + '"]').addClass(currentSortDirection === 'asc' ? 'sorted-asc' : 'sorted-desc');
        }

        function loadOfficerComplaints(page) {
            page = page || 1;
            currentPage = page;
            var data = gatherOfficerFilters();
            data.Page = page;

            $.ajax({
                url: '@Url.Action("ComplaintList", "Officer")',
                type: 'GET',
                cache: false,
                data: data,
                dataType: 'html',
                success: function (html) {
                    $('#complaintsContainer').html(html);
                    $('#pageNumberFilter').val(currentPage);
                    updateSortIndicators();
                },
                error: function () {
                    showToast('Unable to load complaints. Please try again.', 'error', 'Error');
                }
            });
        }

        // Filters are applied only when Search is clicked (or Enter is
        // pressed) — no auto-filter on typing or dropdown change.
        $('#applyFiltersBtn').on('click', function () {
            var page = parseInt($('#pageNumberFilter').val(), 10) || 1;
            if (page < 1) page = 1;
            loadOfficerComplaints(page);
        });

        $('#searchTerm').on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var page = parseInt($('#pageNumberFilter').val(), 10) || 1;
                if (page < 1) page = 1;
                loadOfficerComplaints(page);
            }
        });

        $('#clearFiltersBtn').on('click', function () {
            $('#searchTerm').val('');
            $('#statusFilter, #priorityFilter, #categoryFilter').val('');
            $('#pageNumberFilter').val(1);
            $('#pageSizeFilter').val(10);
            loadOfficerComplaints(1);
        });

        $(document).on('click', '.complaint-sort', function (e) {
            e.preventDefault();
            var sortColumn = $(this).data('sort');
            if (currentSortColumn === sortColumn) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = sortColumn;
                currentSortDirection = 'asc';
            }
            loadOfficerComplaints(1);
            return false;
        });

        $(document).on('click', '.complaint-page', function (e) {
            e.preventDefault();
            var page = parseInt($(this).data('page'));
            if (!isNaN(page)) {
                loadOfficerComplaints(page);
            }
            return false;
        });

        updateSortIndicators();

        function openEditModal(button) {
            var row = $(button);
            $('#editComplaintId').val(row.data('complaint-id'));
            $('#editComplaintNumberLabel').text('#' + row.data('complaint-number'));
            $('#editComplaintTitle').val(row.data('title'));
            $('#editStatusId').val(row.data('status-id'));
            $('#editPriorityId').val(row.data('priority-id'));
            $('#editCategoryId').val(row.data('category-id'));
            document.getElementById('editComplaintModal').style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('editComplaintModal').style.display = 'none';
        }

        $(document).on('click', '.complaint-edit-btn', function () {
            openEditModal(this);
        });
        $('#editComplaintModal').on('click', function (e) {
            if (e.target === this) {
                closeEditModal();
            }
        });

        $('#editComplaintForm').on('submit', function (e) {
            e.preventDefault();
            var submitBtn = $('#updateComplaintBtn');
            var spinner = $('#updateComplaintSpinner');
            submitBtn.prop('disabled', true);
            spinner.removeClass('d-none');

            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    submitBtn.prop('disabled', false);
                    spinner.addClass('d-none');

                    if (res.success) {
                        closeEditModal();
                        showToast('Complaint updated successfully!', 'success', 'Saved');
                        loadOfficerComplaints(currentPage);
                    } else {
                        showToast(res.message || 'Unable to save complaint changes.', 'error', 'Error');
                    }
                },
                error: function () {
                    submitBtn.prop('disabled', false);
                    spinner.addClass('d-none');
                    showToast('An error occurred while updating the complaint. Please try again.', 'error', 'Error');
                }
            });
        });

        // ── Chat modal ──────────────────────────────────────────────
        // Delegated handler (document-level) since row buttons are
        // replaced wholesale every time loadOfficerComplaints() swaps
        // #complaintsContainer's HTML — a directly-bound handler would
        // stop working after the first filter/sort/page action.
        function openChatModal(button) {
            var row = $(button);
            var complaintId = row.data('complaint-id');
            $('#chatModalNumberLabel').text('#' + row.data('complaint-number'));
            $('#chatModalBody').html('<div class="text-center py-5"><span class="spinner-border"></span></div>');
            document.getElementById('chatModal').style.display = 'flex';

            $.ajax({
                url: '/ComplaintChat/ThreadPartial',
                type: 'GET',
                data: { complaintId: complaintId },
                success: function (html) {
                    $('#chatModalBody').html(html);
                },
                error: function (xhr) {
                    $('#chatModalBody').html('<div class="p-3 text-danger">Unable to load the discussion. Status: ' + xhr.status + '</div>');
                }
            });
        }

        function closeChatModal() {
            var panel = document.querySelector('#chatModalBody .chat-panel');
            if (panel && typeof panel.stopChatPolling === 'function') {
                panel.stopChatPolling();
            }
            document.getElementById('chatModal').style.display = 'none';
            $('#chatModalBody').empty();
        }

        $(document).on('click', '.complaint-chat-btn', function () {
            openChatModal(this);
        });
    </script>
}
