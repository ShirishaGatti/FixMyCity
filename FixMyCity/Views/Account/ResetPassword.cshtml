@model FixMyCityModel.ViewModel.ResetPasswordViewModel
@{
    Layout = null;
    ViewBag.Title = "Reset Password";
}
<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password FixMyCity</title>
    <meta name="description" content="Reset your FixMyCity account password" />
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Styles -->
    <link rel="stylesheet" href="~/Content/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />
    <link rel="stylesheet" href="~/Content/css/auth.css" />
</head>
<body class="d-flex flex-column min-vh-100">

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="gc overflow-hidden shadow-lg border-0" style="background: var(--sf);">
                <div class="row g-0">
                    <!-- LEFT PANEL (BRANDING) -->
                    <div class="col-md-5 p-4 p-lg-5 text-white d-flex flex-column justify-content-between position-relative"
                         style="background: linear-gradient(135deg, rgba(21, 116, 224, 0.95), rgba(15, 15, 26, 0.95)), url('https://images.unsplash.com/photo-1477959858617-67f30ac4ce71?auto=format&fit=crop&w=800&q=80') center/cover;">
                        <div class="mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-3 p-3 mb-3 shadow">
                                <i class="bi bi-building-fill fs-3"></i>
                            </div>
                            <h3 class="fw-bold">Fix<span class="text-warning">MyCity</span></h3>
                            <p class="text-white-50 small">Municipal Complaint Application System</p>
                        </div>

                        <div class="my-auto py-4">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                                 style="width:64px;height:64px;background:rgba(255,255,255,0.1);border:2px solid rgba(255,255,255,0.2);">
                                <i class="bi bi-shield-lock-fill fs-4 text-warning"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Set New Password</h4>
                            <p class="text-white-50 small mb-0">
                                Enter the 6-digit OTP sent to your email and choose a strong, secure new password for your account.
                            </p>
                        </div>

                        <div class="pt-3 border-top border-white border-opacity-10 small text-white-50">
                            <i class="bi bi-shield-lock-fill me-1 text-warning"></i> Secure Municipal Citizen Portal
                        </div>
                    </div>

                    <!-- RIGHT PANEL (FORM) -->
                    <div class="col-md-7 p-4 p-lg-5 d-flex flex-column justify-content-center">
                        <div class="mb-3">
                            <a href="@Url.Action("ForgotPassword","Account")" class="text-decoration-none small" style="color:var(--tx3);">
                                <i class="bi bi-arrow-left me-1"></i> Back to Request Code
                            </a>
                        </div>

                        <h4 class="fw-bold mb-1" style="color:var(--tx);">New Password</h4>
                        <p class="mb-4 small" style="color:var(--tx3);">Verify your code and enter your new credentials below.</p>

                        <div id="alertContainer" class="mb-3"></div>

                        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "resetPasswordForm" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.Email)

                            <!-- EMAIL DISPLAY (READ ONLY) -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold small" style="color:var(--tx3);">Resetting Password For</label>
                                <input type="text" class="form-control bg-transparent border-0 p-0 fw-bold" style="color:var(--tx2);" value="@Model.Email" readonly />
                            </div>

                            <!-- OTP CODE -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold small" style="color:var(--tx2);">
                                    <i class="bi bi-hash me-1"></i>6-Digit OTP Verification Code
                                </label>
                                @Html.TextBoxFor(m => m.EnteredOtp, new
                                {
                                    @class = "form-control fw-bold text-center tracking-wider",
                                    placeholder = "000000",
                                    maxlength = "6",
                                    autocomplete = "one-time-code",
                                    style = "letter-spacing: 0.5em; font-size: 1.2rem;"
                                })
                                @Html.ValidationMessageFor(m => m.EnteredOtp, "", new { @class = "field-error small text-danger mt-1 d-block" })
                            </div>

                            <!-- NEW PASSWORD -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold small" style="color:var(--tx2);">
                                    <i class="bi bi-key-fill me-1"></i>New Password
                                </label>
                                <div class="input-group">
                                    @Html.PasswordFor(m => m.NewPassword, new
                                    {
                                        @class = "form-control",
                                        placeholder = "Enter new password",
                                        id = "NewPassword",
                                        autocomplete = "new-password"
                                    })
                                    <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword">
                                        <i class="bi bi-eye-fill" id="newEyeIcon"></i>
                                    </button>
                                </div>
                                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-error small text-danger mt-1 d-block" })
                            </div>

                            <!-- CONFIRM PASSWORD -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold small" style="color:var(--tx2);">
                                    <i class="bi bi-check2-circle me-1"></i>Confirm Password
                                </label>
                                <div class="input-group">
                                    @Html.PasswordFor(m => m.ConfirmPassword, new
                                    {
                                        @class = "form-control",
                                        placeholder = "Confirm new password",
                                        id = "ConfirmPassword",
                                        autocomplete = "new-password"
                                    })
                                    <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                        <i class="bi bi-eye-fill" id="confirmEyeIcon"></i>
                                    </button>
                                </div>
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error small text-danger mt-1 d-block" })
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" id="resetSubmit">
                                <span class="spinner-border spinner-border-sm d-none me-2" id="resetSpinner"></span>
                                <i class="bi bi-shield-check me-1" id="resetIcon"></i>
                                Reset Password
                            </button>
                        }

                        <div class="mt-4 text-center small" style="color:var(--tx3);">
                            Remembered your password?
                            <a href="@Url.Action("Login","Account")" class="fw-semibold" style="color:#1574e0;">Sign In</a>
                        </div>
                    </div>
                    <!-- /RIGHT PANEL -->
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/js/jquery-3.7.1.min.js"></script>
<script src="~/Content/js/bootstrap.bundle.min.js"></script>
<script>
    function showAlert(containerId, message, type) {
        var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
        $(containerId).html(
            '<div class="alert alert-' + type + ' alert-dismissible fade show shadow-sm" role="alert">' +
            '<i class="bi ' + icon + ' me-2"></i>' + message +
            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
            '</div>'
        );
    }

    // Toggle Passwords
    $('#toggleNewPassword').on('click', function () {
        var input = $('#NewPassword');
        var icon = $('#newEyeIcon');
        if (input.attr('type') === 'password') {
            input.attr('type', 'text');
            icon.removeClass('bi-eye-fill').addClass('bi-eye-slash-fill');
        } else {
            input.attr('type', 'password');
            icon.removeClass('bi-eye-slash-fill').addClass('bi-eye-fill');
        }
    });

    $('#toggleConfirmPassword').on('click', function () {
        var input = $('#ConfirmPassword');
        var icon = $('#confirmEyeIcon');
        if (input.attr('type') === 'password') {
            input.attr('type', 'text');
            icon.removeClass('bi-eye-fill').addClass('bi-eye-slash-fill');
        } else {
            input.attr('type', 'password');
            icon.removeClass('bi-eye-slash-fill').addClass('bi-eye-fill');
        }
    });

    $('#resetPasswordForm').on('submit', function (e) {
        e.preventDefault();
        var submitBtn = $('#resetSubmit');
        var spinner = $('#resetSpinner');
        var icon = $('#resetIcon');

        submitBtn.prop('disabled', true);
        spinner.removeClass('d-none');
        icon.addClass('d-none');

        $.ajax({
            url: $(this).attr('action'),
            type: 'POST',
            data: $(this).serialize(),
            success: function (res) {
                submitBtn.prop('disabled', false);
                spinner.addClass('d-none');
                icon.removeClass('d-none');

                if (res.success) {
                    showAlert('#alertContainer', res.message || 'Password reset successfully! Redirecting to login...', 'success');
                    if (res.redirectUrl) {
                        setTimeout(function () {
                            window.location.href = res.redirectUrl;
                        }, 1800);
                    }
                } else {
                    showAlert('#alertContainer', res.message || 'Something went wrong. Please check your inputs.', 'danger');
                }
            },
            error: function (xhr) {
                submitBtn.prop('disabled', false);
                spinner.addClass('d-none');
                icon.removeClass('d-none');
                var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'An error occurred. Please try again.';
                showAlert('#alertContainer', msg, 'danger');
            }
        });
    });
</script>
</body>
</html>
