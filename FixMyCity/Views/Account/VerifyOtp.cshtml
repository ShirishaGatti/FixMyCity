@using FixMyCityModel.ViewModel
@model VerifyOtpViewModel
@{
    Layout = null;
    ViewBag.Title = "Verify OTP";
}
<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title FixMyCity</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/css/style.css" rel="stylesheet" />
    <link href="~/Content/css/auth.css" rel="stylesheet" />
    <link href="~/Content/css/verifyOtp.css" rel="stylesheet" />

</head>

<body>

<div class="otp-wrapper">
    <div class="otp-card">
        <div class="text-center mb-4">
            <div class="otp-icon"><i class="bi bi-shield-lock-fill"></i></div>
            <h3>Verify OTP</h3>
            <p class="otp-text">
                We've sent a 6-digit verification code to your registered email.<br />
                It expires in 5 minutes.
            </p>
        </div>
        <div id="alertContainer"></div>
        @using (Html.BeginForm("VerifyOtp", "Account", FormMethod.Post, new { id = "otpForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.LabelFor(m => m.EnteredOtp, "Enter Verification Code", new { @class = "form-label fw-semibold" })
                @Html.TextBoxFor(m => m.EnteredOtp, new
                {
                    maxlength = "6",
                    @class = "form-control otp-input",
                    autocomplete = "one-time-code",
                    inputmode = "numeric",
                    placeholder = "000000"
                })
                @Html.ValidationMessageFor(m => m.EnteredOtp, "", new { @class = "field-error" })
            </div>

            <button type="submit" class="btn btn-verify w-100" id="otpSubmit">
                <span class="spinner-border spinner-border-sm d-none" id="otpSpinner"></span>
                Verify OTP
            </button>
        }
        <div class="otp-footer">
            <i class="bi bi-arrow-left me-1"></i>
            <a href="@Url.Action("Login", "Account")">Back to login</a>
        </div>
    </div>
</div>

<script src="~/Content/js/jquery-3.7.1.min.js"></script>
    <script src="~/Content/js/auth.js"></script>
<script>
    $(document).ajaxStart(function () { $('#otpSpinner').removeClass('d-none'); $('#otpSubmit').prop('disabled', true); });
    $(document).ajaxStop(function () { $('#otpSpinner').addClass('d-none'); $('#otpSubmit').prop('disabled', false); });
</script>

</body>
</html>