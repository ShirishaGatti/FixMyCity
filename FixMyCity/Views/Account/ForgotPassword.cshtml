@model FixMyCityModel.ViewModel.ForgotPasswordViewModel
@{
    Layout = null;
    ViewBag.Title = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — FixMyCity</title>
    <meta name="description" content="Reset your FixMyCity account password" />
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Styles -->
    <link rel="stylesheet" href="~/Content/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />
    <link rel="stylesheet" href="~/Content/css/auth.css" />
</head>
<body class="d-flex flex-column min-vh-100">

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="gc overflow-hidden shadow-lg border-0" style="background: var(--sf);">
                <div class="row g-0">
                    <!-- LEFT PANEL (BRANDING) -->
                    <div class="col-md-5 p-4 p-lg-5 text-white d-flex flex-column justify-content-between position-relative"
                         style="background: linear-gradient(135deg, rgba(21, 116, 224, 0.95), rgba(15, 15, 26, 0.95)), url('https://images.unsplash.com/photo-1477959858617-67f30ac4ce71?auto=format&fit=crop&w=800&q=80') center/cover;">
                        <div class="mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-3 p-3 mb-3 shadow">
                                <i class="bi bi-building-fill fs-3"></i>
                            </div>
                            <h3 class="fw-bold">Fix<span class="text-warning">MyCity</span></h3>
                            <p class="text-white-50 small">Municipal Complaint Application System</p>
                        </div>

                        <div class="my-auto py-4">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                                 style="width:64px;height:64px;background:rgba(255,255,255,0.1);border:2px solid rgba(255,255,255,0.2);">
                                <i class="bi bi-key-fill fs-4 text-warning"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Forgot Your Password?</h4>
                            <p class="text-white-50 small mb-0">
                                No worries! Enter your registered email address and we'll send you a one-time password to reset your account.
                            </p>
                        </div>

                        <div class="pt-3 border-top border-white border-opacity-10 small text-white-50">
                            <i class="bi bi-shield-lock-fill me-1 text-warning"></i> Secure Municipal Citizen Portal
                        </div>
                    </div>

                    <!-- RIGHT PANEL (FORM) -->
                    <div class="col-md-7 p-4 p-lg-5 d-flex flex-column justify-content-center">
                        <div class="mb-4">
                            <a href="@Url.Action("Login","Account")" class="text-decoration-none small" style="color:var(--tx3);">
                                <i class="bi bi-arrow-left me-1"></i> Back to Login
                            </a>
                        </div>

                        <h4 class="fw-bold mb-1" style="color:var(--tx);">Reset Password</h4>
                        <p class="mb-4 small" style="color:var(--tx3);">Enter your email address to receive a reset code.</p>

                        <div id="alertContainer" class="mb-3"></div>

                        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "forgotPasswordForm" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-semibold small" style="color:var(--tx2);">
                                    <i class="bi bi-envelope-fill me-1"></i>Email Address
                                </label>
                                @Html.TextBoxFor(m => m.Email, new
                                {
                                    @class = "form-control",
                                    placeholder = "your@email.com",
                                    autocomplete = "email",
                                    type = "email"
                                })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error small text-danger mt-1 d-block" })
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" id="forgotSubmit">
                                <span class="spinner-border spinner-border-sm d-none me-2" id="forgotSpinner"></span>
                                <i class="bi bi-send-fill me-1" id="forgotIcon"></i>
                                Send Reset Code
                            </button>
                        }

                        <div class="mt-4 text-center small" style="color:var(--tx3);">
                            Remembered your password?
                            <a href="@Url.Action("Login","Account")" class="fw-semibold" style="color:#1574e0;">Sign In</a>
                        </div>
                    </div>
                    <!-- /RIGHT PANEL -->
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/js/jquery-3.7.1.min.js"></script>
<script src="~/Content/js/bootstrap.bundle.min.js"></script>
<script>
    function showAlert(containerId, message, type) {
        var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
        $(containerId).html(
            '<div class="alert alert-' + type + ' alert-dismissible fade show shadow-sm" role="alert">' +
            '<i class="bi ' + icon + ' me-2"></i>' + message +
            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
            '</div>'
        );
    }

    $('#forgotPasswordForm').on('submit', function (e) {
        e.preventDefault();
        var submitBtn = $('#forgotSubmit');
        var spinner = $('#forgotSpinner');
        var icon = $('#forgotIcon');

        submitBtn.prop('disabled', true);
        spinner.removeClass('d-none');
        icon.addClass('d-none');

        $.ajax({
            url: $(this).attr('action'),
            type: 'POST',
            data: $(this).serialize(),
            success: function (res) {
                submitBtn.prop('disabled', false);
                spinner.addClass('d-none');
                icon.removeClass('d-none');

                if (res.success) {
                    showAlert('#alertContainer', res.message || 'Reset code sent! Check your email.', 'success');
                    // Redirect to reset password page after a short delay
                    if (res.redirectUrl) {
                        setTimeout(function () {
                            window.location.href = res.redirectUrl;
                        }, 1800);
                    }
                } else {
                    showAlert('#alertContainer', res.message || 'Something went wrong. Please try again.', 'danger');
                }
            },
            error: function (xhr) {
                submitBtn.prop('disabled', false);
                spinner.addClass('d-none');
                icon.removeClass('d-none');
                var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'An error occurred. Please try again.';
                showAlert('#alertContainer', msg, 'danger');
            }
        });
    });
</script>
</body>
</html>
