@{
    Layout = null; // standalone layout — no public _Layout
    var activePage = ViewBag.ActivePage as string ?? "";
}
<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Dashboard") — FixMyCity</title>
    <meta name="description" content="FixMyCity Citizen Dashboard" />

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Styles -->
    <link rel="stylesheet" href="~/Content/css/style.css" />
    <link rel="stylesheet" href="~/Content/css/citizen.css" />
    <link href="~/Content/css/officer.css" rel="stylesheet" />

    <!-- ApexCharts CDN for Interactive Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    @RenderSection("head", required: false)
</head>
<body>

<div class="citizen-shell">

    <!-- ── TOP NAVBAR ─────────────────────────────────── -->
    <nav class="dash-navbar">
        <div class="d-flex align-items-center gap-3">
            <button class="dash-sidebar-toggle" id="sidebarToggle" title="Menu">
                <i class="bi bi-list"></i>
            </button>
            <a href="@Url.Action("Home", "Complaint")" class="dash-brand">
                <div class="dash-brand-icon"><i class="bi bi-building-fill"></i></div>
                Fix<span style="background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">MyCity</span>
            </a>
        </div>

        <div class="dash-nav-right">
            <!-- Theme toggle -->
            <button class="dash-theme-btn" id="dashThemeBtn" title="Toggle theme">
                <i class="bi bi-sun-fill text-warning" id="dashSunIcon" style="display:none"></i>
                <i class="bi bi-moon-stars-fill text-info" id="dashMoonIcon"></i>
                <span id="dashThemeLabel" class="d-none d-sm-inline">Dark</span>
            </button>

            <!-- Profile -->
            <a href="@Url.Action("Profile", "Complaint")" class="dash-profile-btn" title="Profile">
                <i class="bi bi-person-fill"></i>
            </a>

            <!-- Logout -->
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "navLogoutForm", @class = "d-inline" }))
            {
                <button type="submit" class="dash-logout-btn" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="d-none d-sm-inline">Logout</span>
                </button>
            }
        </div>
    </nav>

    <!-- ── BODY ───────────────────────────────────────── -->
    <div class="dash-body">

        <!-- ── SIDEBAR ───────────────────────────────── -->
        <aside class="dash-sidebar" id="dashSidebar">

            <div class="sidebar-section-label">Navigation</div>
            <ul class="sidebar-nav">
                <li>
                    <a href="@Url.Action("Home", "Complaint")"
                       class="nav-link @(activePage == "Home" ? "active" : "")">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Home</span>
                    </a>
                </li>
            </ul>
            <ul class="sidebar-nav">
                <li>
                    <a href="@Url.Action("MyComplaints", "Complaint")"
                       class="nav-link @(activePage == "MyComplaints" ? "active" : "")">
                        <i class="bi bi-clipboard2-check-fill"></i>
                        <span>My Complaints</span>
                    </a>
                </li>
            </ul>
            
            <hr class="sidebar-divider" />

            <div class="sidebar-section-label">Account</div>
            <ul class="sidebar-nav">
                <li>
                    <a href="@Url.Action("Profile", "Complaint")"
                       class="nav-link @(activePage == "Profile" ? "active" : "")">
                        <i class="bi bi-person-fill-gear"></i>
                        <span>Profile Settings</span>
                    </a>
                </li>
            </ul>

            <!-- Quick action at bottom -->
            <div style="margin-top:auto; padding-top:1rem;">
                <a href="@Url.Action("MyComplaints", "Complaint")"
                   class="btn-dash-primary w-100 justify-content-center">
                    <i class="bi bi-plus-circle-fill"></i>
                    File Complaint
                </a>
            </div>

        </aside>

        <!-- ── MAIN CONTENT ───────────────────────────── -->
        <main class="dash-main">
            @RenderBody()
        </main>

    </div>
</div>

<!-- Scripts -->
<script src="~/Content/js/jquery-3.7.1.min.js"></script>
<script>
    // ── Theme ────────────────────────────────────────────
    function applyDashTheme(isLight) {
        var root = document.getElementById('htmlRoot');
        if (isLight) {
            root.classList.add('lm');
            document.getElementById('dashSunIcon').style.display = '';
            document.getElementById('dashMoonIcon').style.display = 'none';
            var lbl = document.getElementById('dashThemeLabel');
            if (lbl) lbl.textContent = 'Light';
        } else {
            root.classList.remove('lm');
            document.getElementById('dashSunIcon').style.display = 'none';
            document.getElementById('dashMoonIcon').style.display = '';
            var lbl = document.getElementById('dashThemeLabel');
            if (lbl) lbl.textContent = 'Dark';
        }
    }
    var savedTheme = localStorage.getItem('fixmycity_theme');
    applyDashTheme(savedTheme === 'light');

    document.getElementById('dashThemeBtn').addEventListener('click', function () {
        var isLight = !document.getElementById('htmlRoot').classList.contains('lm');
        applyDashTheme(isLight);
        localStorage.setItem('fixmycity_theme', isLight ? 'light' : 'dark');
    });

</script>
<script>
    document.getElementById('sidebarToggle').addEventListener('click', function () {
        document.getElementById('dashSidebar').classList.toggle('open');
    });
</script>

    <script>
        function confirmDialog(message, onOk) {
            var overlay = document.getElementById('globalConfirmOverlay');
            document.getElementById('globalConfirmMsg').textContent = message;
            overlay.style.display = 'flex';
            overlay._onOk = onOk;
        }
        function hideConfirmDialog() {
            document.getElementById('globalConfirmOverlay').style.display = 'none';
        }
        function confirmOk() {
            if (typeof document.getElementById('globalConfirmOverlay')._onOk === 'function') {
                document.getElementById('globalConfirmOverlay')._onOk();
            }
            hideConfirmDialog();
        }
        function showPageLoading() {
            document.getElementById('globalLoadingOverlay').style.display = 'flex';
        }
        function hidePageLoading() {
            document.getElementById('globalLoadingOverlay').style.display = 'none';
        }
        function showToast(message, type, title) {
            type = type || 'success';
            var container = document.getElementById('toastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toastContainer';
                document.body.appendChild(container);
            }
            var iconClass = 'bi-check-circle-fill';
            var defaultTitle = 'Success';
            var toastClass = 'toast-success';

            if (type === 'error' || type === 'danger' || type === 'delete') {
                toastClass = 'toast-error';
                iconClass = 'bi-exclamation-triangle-fill';
                defaultTitle = 'Error';
            } else if (type === 'warning') {
                toastClass = 'toast-warning';
                iconClass = 'bi-exclamation-circle-fill';
                defaultTitle = 'Warning';
            } else if (type === 'info') {
                toastClass = 'toast-info';
                iconClass = 'bi-info-circle-fill';
                defaultTitle = 'Information';
            }

            var toastTitle = title || defaultTitle;
            var toast = document.createElement('div');
            toast.className = 'fmc-toast ' + toastClass;
            toast.innerHTML = 
                '<i class="bi ' + iconClass + ' fmc-toast-icon"></i>' +
                '<div class="fmc-toast-content">' +
                    '<div class="fmc-toast-title">' + toastTitle + '</div>' +
                    '<div>' + message + '</div>' +
                '</div>' +
                '<button type="button" class="fmc-toast-close" onclick="this.parentElement.remove()">&times;</button>';

            container.appendChild(toast);
            setTimeout(function() {
                if (toast && toast.parentElement) {
                    toast.classList.add('toast-out');
                    setTimeout(function() { if (toast.parentElement) toast.remove(); }, 300);
                }
            }, 4500);
        }
    </script>

    <div id="toastContainer"></div>

    @if (TempData["Success"] != null)
    {
        <script>document.addEventListener("DOMContentLoaded", function() { showToast("@HttpUtility.JavaScriptStringEncode(TempData["Success"].ToString())", "success", "Success"); });</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>document.addEventListener("DOMContentLoaded", function() { showToast("@HttpUtility.JavaScriptStringEncode(TempData["Error"].ToString())", "error", "Error"); });</script>
    }

    @RenderSection("scripts", required: false)
    <!-- ── Global confirm dialog ─────────────────────────────── -->
    <div class="dash-modal-overlay" id="globalConfirmOverlay" style="display:none;" onclick="hideConfirmDialog()">
        <div class="dash-modal" style="max-width:400px;" onclick="event.stopPropagation()">
            <div class="dash-modal-header"><h5>Confirm</h5></div>
            <div class="dash-modal-body"><p id="globalConfirmMsg" class="mb-0"></p></div>
            <div class="dash-modal-footer">
                <button type="button" class="btn-dash-outline" onclick="hideConfirmDialog()">Cancel</button>
                <button type="button" class="btn-dash-primary" onclick="confirmOk()">OK</button>
            </div>
        </div>
    </div>
    <!-- ── Global page loading overlay ───────────────────────── -->
    <div class="dash-modal-overlay" id="globalLoadingOverlay" style="display:none;z-index:9999;background:rgba(0,0,0,0.35);" onclick="return false;">
        <div class="text-center text-white"><div class="spinner-border spinner-border-lg mb-2" role="status"></div><p class="mb-0">Loading...</p></div>
    </div>
    @*@RenderSection("scripts", required: false)*@


</body>
</html>
