@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    <link href="~/Content/css/officer.css" rel="stylesheet" />
    @RenderSection("officerStyles", false)
}

<div class="admin-shell d-flex">

    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <aside class="admin-sidebar">

        <!-- Brand -->
        <div class="admin-brand px-3 py-3 d-flex align-items-center gap-2 border-bottom">
            <div class="admin-brand-icon">
                <i class="bi bi-shield-fill-check"></i>
            </div>
            <span class="fw-bold text-white">Officer<span style="color:#38bdf8">Panel</span></span>
        </div>

        <!-- Nav -->
        <nav class="admin-nav-wrap pt-3">
            <p class="admin-nav-label">Main Menu</p>
            <ul class="admin-nav list-unstyled">

                <li>
                    <a href="@Url.Action("Dashboard", "Officer")"
                       class="admin-nav-link @(ViewBag.ActivePage == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Complaints", "Officer")"
                       class="admin-nav-link @(ViewBag.ActivePage == "Complaints" ? "active" : "")">
                        <i class="bi bi-list-check"></i>
                        <span>Complaints</span>
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Profile", "Officer")"
                       class="admin-nav-link @(ViewBag.ActivePage == "Profile" ? "active" : "")">
                        <i class="bi bi-person-fill"></i>
                        <span>Profile</span>
                    </a>
                </li>

            </ul>
        </nav>

    </aside>
    <!-- /Sidebar -->

    <!-- ── Content wrapper ──────────────────────────────────── -->
    <div class="admin-content flex-grow-1">

        <!-- Topbar -->
        <div class="admin-topbar d-flex align-items-center justify-content-between px-4 py-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-grid-1x2-fill text-primary"></i>
                <span class="fw-semibold text-white">
                    @(ViewBag.Title ?? "Officer")
                </span>
            </div>
            <div class="d-flex align-items-center gap-2 text-white-50 small">
                <i class="bi bi-person-circle me-1"></i>
                @if (Request.IsAuthenticated)
                {
                    <span>@User.Identity.Name</span>
                }
                <span class="mx-2 text-muted">|</span>
                <i class="bi bi-circle-fill text-success" style="font-size:.5rem"></i>
                <span>Officer</span>
            </div>
        </div>

        <!-- Page body -->
        <div class="p-4">
            @RenderBody()
        </div>

    </div>
    <!-- /Content wrapper -->

</div>

@section scripts {
    @RenderSection("officerScripts", required: false)
}
