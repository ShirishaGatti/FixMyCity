                                                <td><span class="status-badge @(c.StatusName?.ToLower().Replace(" ","") ?? "")">@(c.StatusName ?? "Open")</span></td>
                                                <td><span class="priority-badge @(c.PriorityName?.ToLower() ?? "")">@(c.PriorityName ?? "Medium")</span></td>
