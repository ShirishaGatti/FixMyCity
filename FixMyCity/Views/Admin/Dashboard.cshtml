@model FixMyCityModel.ViewModel.AdminDashboardViewModel
@{
    ViewBag.Title = "Admin Dashboard";
    ViewBag.ActivePage = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int openCnt = Model?.OpenComplaints ?? 0;
    int progCnt = Model?.InProgressComplaints ?? 0;
    int resCnt = Model?.ResolvedComplaints ?? 0;
    int clsCnt = Model?.ClosedComplaints ?? 0;
    int totalCnt = Model?.TotalComplaints ?? 0;
    double resRate = totalCnt > 0 ? Math.Round((double)(resCnt + clsCnt) / totalCnt * 100, 1) : 0;
}
<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <link href="~/Content/css/admin.css" rel="stylesheet" />
</head>
<body>
    <!-- Top Header Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color:var(--tx)">Executive Analytics Dashboard</h3>
            <p class="text-muted small mb-0">Real-time civic operations, department metrics, and city resolution performance.</p>
        </div>
        <div>
            <span class="badge px-3 py-2" style="background:rgba(56,189,248,0.12);color:#38bdf8;border:1px solid rgba(56,189,248,0.3);border-radius:8px;">
                <i class="bi bi-broadcast me-1"></i> Live System Monitoring
            </span>
        </div>
    </div>
    <!-- Key Performance Indicators (KPI Cards) -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-sm-6">
            <div class="dash-stat">
                <div class="ds-icon" style="background:linear-gradient(135deg,#f59e0b,#ea580c)"><i class="bi bi-people-fill"></i></div>
                <div>
                    <div class="ds-val">@(Model?.TotalUsers ?? 0)</div>
                    <div class="ds-lbl">Total Registered Users</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="dash-stat">
                <div class="ds-icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-file-earmark-exclamation-fill"></i></div>
                <div>
                    <div class="ds-val">@(Model?.TotalComplaints ?? 0)</div>
                    <div class="ds-lbl">Total Complaints Logged</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="dash-stat">
                <div class="ds-icon" style="background:linear-gradient(135deg,#059669,#34d399)"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="ds-val">@resRate%</div>
                    <div class="ds-lbl">Overall Resolution Rate</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="dash-stat">
                <div class="ds-icon" style="background:linear-gradient(135deg,#1574e0,#38bdf8)"><i class="bi bi-shield-fill-check"></i></div>
                <div>
                    <div class="ds-val">@(Model?.TotalOfficers ?? 0)</div>
                    <div class="ds-lbl">Active Municipal Officers</div>
                </div>
            </div>
        </div>
    </div>
    <!-- Chart Row 1: Donut Status Breakdown & Monthly Spline Area Trend -->
    <div class="row g-3 mb-4">
        <!-- Pie / Donut Chart: Complaint Status Breakdown -->
        <div class="col-lg-5">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-pie-chart-fill me-2 text-warning"></i>Complaint Status Distribution</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Interactive Pie</span>
                </div>
                <div class="dash-card-body d-flex flex-column align-items-center justify-content-center">
                    <div id="adminStatusChart" class="chart-box"></div>
                    <div class="row g-2 w-100 mt-2">
                        <div class="col-3">
                            <div class="stat-pill">
                                <div class="sp-val text-warning">@openCnt</div>
                                <div class="sp-lbl">Open</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-pill">
                                <div class="sp-val text-info">@progCnt</div>
                                <div class="sp-lbl">In Progress</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-pill">
                                <div class="sp-val text-success">@resCnt</div>
                                <div class="sp-lbl">Resolved</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-pill">
                                <div class="sp-val text-secondary">@clsCnt</div>
                                <div class="sp-lbl">Closed</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Graph: Monthly Complaint & Resolution Trend (Spline Area Graph) -->
        <div class="col-lg-7">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Monthly Complaint & Resolution Trend</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Time Series Graph</span>
                </div>
                <div class="dash-card-body">
                    <div id="adminTrendChart" class="chart-box"></div>
                </div>
            </div>
        </div>
    </div>
    <!-- Chart Row 2: Category Bar Graph, Mathematical Radar Diagram, Radial SLA Gauge -->
    <div class="row g-3 mb-4">
        <!-- Bar Graph: Complaints by Category -->
        <div class="col-lg-4">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-bar-chart-fill me-2 text-info"></i>Complaints by Category</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Bar Graph</span>
                </div>
                <div class="dash-card-body">
                    <div id="adminCategoryChart" class="chart-box"></div>
                </div>
            </div>
        </div>
        <!-- Mathematical Diagram: Department Performance Equilibrium Radar -->
        <div class="col-lg-4">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-hexagon-fill me-2 text-primary"></i>Department SLA Equilibrium</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Radar Diagram</span>
                </div>
                <div class="dash-card-body">
                    <div id="adminRadarChart" class="chart-box"></div>
                </div>
            </div>
        </div>
        <!-- Radial Diagram: City SLA Compliance Gauge -->
        <div class="col-lg-4">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-speedometer me-2 text-success"></i>City SLA Compliance Rating</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Gauge Metric</span>
                </div>
                <div class="dash-card-body d-flex flex-column align-items-center justify-content-center">
                    <div id="adminSlaGaugeChart" class="chart-box"></div>
                    <p class="text-muted small text-center mb-0 mt-2">Target resolution turnaround within 48 Hours: <strong class="text-success">92.5% Success</strong></p>
                </div>
            </div>
        </div>
    </div>
    <!-- Recent Complaints Feed Table -->
    @*<div class="row g-3">
            <div class="col-12">
                <div class="dash-card">
                    <div class="dash-card-header">
                        <span><i class="bi bi-list-stars me-2 text-primary"></i>Recent Municipal Activity Feed</span>
                        <a href="@Url.Action("Users","Admin")" class="btn btn-sm btn-outline-primary" style="border-radius:8px;font-size:0.78rem;">View All Users</a>
                    </div>
                    <div class="dash-card-body p-0">
                        @if (Model?.RecentComplaints != null && Model.RecentComplaints.Any())
                        {
