@model FixMyCityModel.ViewModel.AdminDashboardViewModel

@{
    ViewBag.Title = "Admin Dashboard";
    ViewBag.ActivePage = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section adminStyles {
    <style>
        .dash-stat {
            background: var(--bg3);
            border: 1px solid var(--bd);
            border-radius: 16px;
            padding: 20px 22px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: transform .2s, box-shadow .2s;
        }
        .dash-stat:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,.2); }
        .dash-stat .ds-icon {
            width: 54px; height: 54px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1.4rem; flex-shrink: 0;
        }
        .dash-stat .ds-val { font-size: 1.8rem; font-weight: 800; color: var(--tx); line-height: 1; }
        .dash-stat .ds-lbl { font-size: .8rem; color: var(--tx3); margin-top: 2px; }
        .dash-card {
            background: var(--bg3);
            border: 1px solid var(--bd);
            border-radius: 16px; overflow: hidden;
        }
        .dash-card-header {
            padding: 14px 18px;
            font-weight: 700; font-size: .9rem;
            border-bottom: 1px solid var(--bd);
            color: var(--tx);
        }
        .dash-card-body { padding: 16px 18px; }
        .dash-table { color: var(--tx); margin: 0; }
        .dash-table thead th {
            background: transparent; color: var(--tx3);
            font-size: .72rem; text-transform: uppercase; letter-spacing: .08em;
            padding: 10px 16px; border: 0; font-weight: 600;
            border-bottom: 1px solid var(--bd); text-align: left;
        }
        .dash-table tbody td { padding: 14px 16px; border-bottom: 1px solid var(--bd); font-size: .875rem; vertical-align: middle; }
        .dash-table tr:last-child td { border-bottom: none; }
        .dash-table tbody tr:hover td { background: rgba(139, 92, 246, 0.04); }
        .status-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .05em;
        }
        .status-badge.open { background: rgba(245,158,11,.12); color: #f59e0b; }
        .status-badge.inprogress { background: rgba(59,130,246,.12); color: #3b82f6; }
        .status-badge.resolved { background: rgba(16,185,129,.12); color: #10b981; }
        .status-badge.closed { background: rgba(107,114,128,.15); color: #9ca3af; }
        .priority-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 6px;
            font-size: .7rem;
            font-weight: 600;
        }
        .priority-badge.high { background: rgba(239,68,68,.12); color: #ef4444; }
        .priority-badge.medium { background: rgba(245,158,11,.12); color: #f59e0b; }
        .priority-badge.low { background: rgba(16,185,129,.12); color: #10b981; }
        .bar-chart-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 0;
        }
        .bar-chart-item .bcl {
            width: 100px;
            font-size: .78rem;
            color: var(--tx3);
            flex-shrink: 0;
            text-align: right;
        }
        .bar-chart-item .bcf {
            flex: 1;
            height: 22px;
            background: rgba(148,163,184,.08);
            border-radius: 6px;
            overflow: hidden;
            position: relative;
        }
        .bar-chart-item .bcf .bar {
            height: 100%;
            border-radius: 6px;
            transition: width .4s ease;
            min-width: 2px;
        }
        .bar-chart-item .bcv {
            width: 30px;
            font-size: .78rem;
            font-weight: 600;
            color: #f1f5f9;
            flex-shrink: 0;
        }
        .stat-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid rgba(148,163,184,.08);
        }
        .stat-row:last-child { border-bottom: none; }
        html.lm .dash-stat { background: var(--bg3); border-color: var(--bd); }
        html.lm .dash-stat .ds-val { color: var(--tx); }
        html.lm .dash-card { background: var(--bg3); border-color: var(--bd); }
        html.lm .dash-card-header { color: var(--tx); border-color: var(--bd); }
        html.lm .bar-chart-item .bcl { color: var(--tx3); }
        html.lm .bar-chart-item .bcf { background: var(--bd); }
        html.lm .bar-chart-item .bcv { color: var(--tx); }
        html.lm .stat-row { border-color: var(--bd); }
    </style>
}

<div class="row g-3 mb-4">
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#1574e0,#38bdf8)"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="ds-val">@(Model?.TotalUsers ?? 0)</div>
                <div class="ds-lbl">Total Users</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-file-earmark-exclamation-fill"></i></div>
            <div>
                <div class="ds-val">@(Model?.TotalComplaints ?? 0)</div>
                <div class="ds-lbl">Total Complaints</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#059669,#34d399)"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="ds-val">@(Model?.ResolvedComplaints ?? 0)</div>
                <div class="ds-lbl">Resolved</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="dash-stat">
            <div class="ds-icon" style="background:linear-gradient(135deg,#be185d,#f472b6)"><i class="bi bi-shield-fill-check"></i></div>
            <div>
                <div class="ds-val">@(Model?.TotalOfficers ?? 0)</div>
                <div class="ds-lbl">Officers</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Category Breakdown Chart -->
    <div class="col-lg-6">
        <div class="dash-card">
            <div class="dash-card-header">
                <i class="bi bi-bar-chart-fill me-2 text-primary"></i>Complaints by Category
            </div>
            <div class="dash-card-body">
                @if (Model?.TopCategories != null && Model.TopCategories.Any())
                {
                    int maxCount = Model.TopCategories.Max(c => c.Count);
                    foreach (var cat in Model.TopCategories)
                    {
                        <div class="bar-chart-item">
                            <div class="bcl">@cat.CategoryName</div>
                            <div class="bcf">
                                <div class="bar" style="width:@((double)cat.Count / maxCount * 100)%;background:linear-gradient(135deg,#1574e0,#38bdf8);"></div>
                            </div>
                            <div class="bcv">@cat.Count</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">No category data available.</p>
                }
            </div>
        </div>
    </div>

    <!-- Status Breakdown -->
    <div class="col-lg-6">
        <div class="dash-card">
            <div class="dash-card-header">
                <i class="bi bi-pie-chart-fill me-2 text-info"></i>Status Breakdown
            </div>
            <div class="dash-card-body">
                <div class="stat-row">
                    <span class="text-muted small">Open</span>
                    <strong class="text-warning">@(Model?.OpenComplaints ?? 0)</strong>
                </div>
                <div class="stat-row">
                    <span class="text-muted small">In Progress</span>
                    <strong class="text-info">@(Model?.InProgressComplaints ?? 0)</strong>
                </div>
                <div class="stat-row">
                    <span class="text-muted small">Resolved</span>
                    <strong class="text-success">@(Model?.ResolvedComplaints ?? 0)</strong>
                </div>
                <div class="stat-row">
                    <span class="text-muted small">Closed</span>
                    <strong style="color:var(--tx3)">@(Model?.ClosedComplaints ?? 0)</strong>
                </div>
                <hr style="border-color:rgba(148,163,184,.1);margin:12px 0" />
                <div class="stat-row">
                    <span class="text-muted small">Total Cities</span>
                    <strong class="text-white">@(Model?.TotalCities ?? 0)</strong>
                </div>
                <div class="stat-row">
                    <span class="text-muted small">Departments</span>
                    <strong class="text-white">@(Model?.TotalDepartments ?? 0)</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-4">
    <div class="col-lg-8">
        <div class="dash-card">
            <div class="dash-card-header">
                <i class="bi bi-file-earmark-text-fill me-2 text-primary"></i>Recent Complaints
            </div>
            <div class="dash-card-body">
                @if (Model != null && Model.RecentComplaints != null && Model.RecentComplaints.Any())
                {
                    <div class="table-responsive">
                        <table class="table dash-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Number</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.RecentComplaints)
                                {
                                    <tr>
                                        <td>@c.ComplaintId</td>
                                        <td><code style="color:#38bdf8">@c.ComplaintNumber</code></td>
                                        <td>@c.Title</td>
                                        <td><span class="status-badge @(c.StatusName?.ToLower().Replace(" ","") ?? "")">@(c.StatusName ?? "N/A")</span></td>
                                        <td><span class="priority-badge @(c.PriorityName?.ToLower() ?? "")">@(c.PriorityName ?? "N/A")</span></td>
                                        <td class="text-muted" style="font-size:.8rem">@c.CreatedAt.ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">No complaints yet.</p>
                }
            </div>
        </div>
    </div>
</div>