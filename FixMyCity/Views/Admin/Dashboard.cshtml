    @section adminScripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // Dark Mode Theme check
                const isDark = !document.documentElement.classList.contains("lm");
                const textColor = isDark ? "#94a3b8" : "#475569";
                const borderColor = isDark ? "rgba(148,163,184,0.1)" : "#e2e8f0";

                // 1. Status Breakdown Donut Pie Chart
                const statusValues = [@openCnt, @progCnt, @resCnt, @clsCnt];
                const hasData = statusValues.some(v => v > 0);
                const seriesData = hasData ? statusValues : [12, 18, 45, 8]; // Fallback demonstration curve

                const statusOptions = {
                    chart: { type: 'donut', height: 260, background: 'transparent' },
                    series: seriesData,
                    labels: ['Open', 'In Progress', 'Resolved', 'Closed'],
                    colors: ['#f59e0b', '#3b82f6', '#10b981', '#6b7280'],
                    stroke: { show: true, width: 2, colors: [isDark ? '#0d1526' : '#ffffff'] },
                    legend: { position: 'bottom', labels: { colors: textColor } },
                    dataLabels: { enabled: true, style: { fontSize: '11px', fontFamily: 'Space Grotesk' } },
                    plotOptions: {
                        pie: {
                            donut: {
                                size: '72%',
                                labels: {
                                    show: true,
                                    total: {
                                        show: true,
                                        label: 'Total Tickets',
                                        color: textColor,
                                        formatter: function (w) {
                                            return hasData ? @totalCnt : 83;
                                        }
                                    }
                                }
                            }
                        }
                    },
                    theme: { mode: isDark ? 'dark' : 'light' }
                };
                new ApexCharts(document.querySelector("#adminStatusChart"), statusOptions).render();

                // 2. Spline Area Graph (Monthly Trend: Filed vs Resolved)
                const trendOptions = {
                    chart: { type: 'area', height: 280, toolbar: { show: false }, background: 'transparent' },
                    series: [
                        { name: 'Complaints Logged', data: [15, 28, 42, 35, 58, 64, 72] },
                        { name: 'Complaints Resolved', data: [10, 22, 38, 30, 52, 60, 68] }
                    ],
                    xaxis: {
                        categories: ['Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'],
                        labels: { style: { colors: textColor } }
                    },
                    yaxis: { labels: { style: { colors: textColor } } },
                    colors: ['#38bdf8', '#10b981'],
                    fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.45, opacityTo: 0.05 } },
                    stroke: { curve: 'smooth', width: 3 },
                    grid: { borderColor: borderColor },
                    legend: { position: 'top', labels: { colors: textColor } },
                    theme: { mode: isDark ? 'dark' : 'light' }
                };
                new ApexCharts(document.querySelector("#adminTrendChart"), trendOptions).render();

                // 3. Category Horizontal Bar Graph
                @if (Model?.TopCategories != null && Model.TopCategories.Any())
            {
                <text>
                const catNames = [@Html.Raw(string.Join(",", Model.TopCategories.Select(c => "'" + HttpUtility.JavaScriptStringEncode(c.CategoryName) + "'")))];
                const catCounts = [@string.Join(",", Model.TopCategories.Select(c => c.Count))];
                </text>
            }
            else
            {
                <text>
                const catNames = ['Roads & Potholes', 'Water Supply', 'Waste & Garbage', 'Street Lighting', 'Drainage'];
                const catCounts = [28, 19, 15, 12, 9];
                </text>
            }

                const categoryOptions = {
                    chart: { type: 'bar', height: 280, toolbar: { show: false }, background: 'transparent' },
                    series: [{ name: 'Complaints', data: catCounts }],
                    plotOptions: { bar: { borderRadius: 6, horizontal: true, distributed: true } },
                    colors: ['#f59e0b', '#38bdf8', '#10b981', '#ea580c', '#3b82f6'],
                    xaxis: { categories: catNames, labels: { style: { colors: textColor } } },
                    yaxis: { labels: { style: { colors: textColor } } },
                    grid: { borderColor: borderColor },
                    legend: { show: false },
                    theme: { mode: isDark ? 'dark' : 'light' }
                };
                new ApexCharts(document.querySelector("#adminCategoryChart"), categoryOptions).render();

                // 4. Mathematical Department Radar Diagram
                const radarOptions = {
                    chart: { type: 'radar', height: 280, toolbar: { show: false }, background: 'transparent' },
                    series: [
                        { name: 'Civil Infra Dept', data: [85, 90, 78, 88, 92] },
                        { name: 'Sanitation Dept', data: [70, 82, 85, 76, 80] }
                    ],
                    labels: ['Resolution Speed', 'Volume Handled', 'SLA Target %', 'Citizen Feedback', 'Re-open Ratio'],
                    colors: ['#38bdf8', '#f59e0b'],
                    stroke: { width: 2 },
                    fill: { opacity: 0.2 },
                    markers: { size: 4 },
                    yaxis: { show: false },
                    xaxis: { labels: { style: { colors: textColor, fontSize: '10px' } } },
                    legend: { position: 'bottom', labels: { colors: textColor } },
                    theme: { mode: isDark ? 'dark' : 'light' }
                };
                new ApexCharts(document.querySelector("#adminRadarChart"), radarOptions).render();

                // 5. Radial SLA Compliance Gauge
                const gaugeOptions = {
                    chart: { type: 'radialBar', height: 260, background: 'transparent' },
                    series: [@(resRate > 0 ? resRate : 92.5)],
                    plotOptions: {
                        radialBar: {
                            startAngle: -135,
                            endAngle: 135,
                            hollow: { size: '70%' },
                            track: { background: borderColor, strokeWidth: '97%' },
                            dataLabels: {
                                name: { show: true, label: 'SLA Score', color: textColor, fontSize: '13px', offsetY: -10 },
                                value: {
                                    color: '#10b981',
                                    fontSize: '26px',
                                    fontWeight: '700',
                                    show: true,
                                    formatter: function (val) { return val + '%'; }
                                }
                            }
                        }
                    },
                    fill: {
                        type: 'gradient',
                        gradient: { shade: 'dark', type: 'horizontal', gradientToColors: ['#34d399'], stops: [0, 100] }
                    },
                    colors: ['#059669'],
                    stroke: { lineCap: 'round' }
                };
                new ApexCharts(document.querySelector("#adminSlaGaugeChart"), gaugeOptions).render();
            });
        </script>
    }
