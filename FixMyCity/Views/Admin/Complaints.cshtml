@model FixMyCityModel.ViewModel.AdminComplaintListViewModel

@{
    ViewBag.Title = "Complaint Assignment";
    ViewBag.ActivePage = "Complaints";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
<link href="~/Content/css/admin-grid.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="row">

        <!-- Main Content -->
        <div class="col-12">
            <div class="page-card mt-4">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Complaint Assignment</h3>
                    <span class="results-summary" id="complaintsSummary"></span>
                </div>

                <form id="complaintsFilterForm" data-grid-url="@Url.Action("ComplaintsGrid","Admin")" class="filter-card mb-4">
                    @Html.AntiForgeryToken()

                    <div class="row g-2">
                        <div class="col-md-2">
                            @Html.DropDownList("Filter.CategoryId",
                                     new SelectList(Model.Categories, "CategoryId", "CategoryName", Model.Filter.CategoryId),
                                     "All Categories",
                                     new { @class = "form-control form-select" })
                        </div>
                        <div class="col-md-2">
                            @Html.DropDownList("Filter.CityId",
                                     new SelectList(Model.Cities, "CityId", "CityName", Model.Filter.CityId),
                                     "All Cities",
                                     new { @class = "form-control form-select" })
                        </div>
                        <div class="col-md-2">
                            @Html.DropDownList("Filter.WardId",
                                     new SelectList(Model.Wards, "WardId", "WardName", Model.Filter.WardId),
                                      "All Wards",
                                      new { @class = "form-control form-select" })
                        </div>
                        <div class="col-md-2">
                            @Html.DropDownList("Filter.PriorityId",
                                     new SelectList(Model.Priorities, "PriorityId", "PriorityName", Model.Filter.PriorityId),
                                      "All Priorities",
                                      new { @class = "form-control form-select" })
                        </div>
                        <div class="col-md-2">
                            @Html.DropDownList("Filter.StatusId",
                                     new SelectList(Model.Statuses, "StatusId", "StatusName", Model.Filter.StatusId),
                                      "All Statuses",
                                      new { @class = "form-control form-select" })
                        </div>
                        <div class="col-md-2">
                            <div class="input-group">
                                <select name="Filter.AssignedTo" class="form-control form-select">
                                    <option value="">All Officers</option>
                                    @foreach (var officer in Model.Filter.Officers)
                                    {
                                        <option value="@officer.ConsumerId" @(Model.Filter.AssignedTo == officer.ConsumerId ? "selected" : "")>
                                            @officer.Name@(string.IsNullOrWhiteSpace(officer.Designation) ? "" : "-" + officer.Designation)
                                        </option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary" title="Search">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mt-2 align-items-center">
                        <div class="col-md-2">
                            <select name="Filter.PageSize" class="form-control form-select">
                                @foreach (var size in new[] { 10, 25, 50, 100 })
                                {
                                    <option value="@size" selected="@(Model.Filter.PageSize == size)">@size / page</option>
                                }
                            </select>
                        </div>

                        <input type="hidden" name="Filter.SortBy" value="@Model.Filter.SortBy" />
                        <input type="hidden" name="Filter.SortDir" value="@Model.Filter.SortDir" />
                        <input type="hidden" name="Filter.PageNumber" value="1" />

                        <div class="col-md-auto ms-auto">
                            <button type="button" id="complaintsClearFilters" class="btn btn-outline-secondary">
                                <i class="fa fa-rotate-left"></i> Clear Filters
                            </button>
                        </div>
                    </div>

                </form>

              

                <div id="complaintsGridContainer">
                    @Html.Partial("_ComplaintsGrid", Model)
                </div>

            </div>
        </div>

    </div>
</div>

<div class="dash-modal-overlay" id="assignComplaintModal" style="display:none;" onclick="closeAssignComplaintModal()">
    <div class="dash-modal assign-complaint-modal" id="assignComplaintModalContent" onclick="event.stopPropagation()">
        <!-- injected by _AssignComplaintModal partial -->
    </div>
</div>

@section adminScripts {
    <script>
        // Only URL constants — all logic lives in admin-complaints.js.
        window.adminComplaintsUrls = {
            deleteComplaint: '@Url.Action("DeleteComplaint","Admin")',
            assignComplaint: '@Url.Action("AssignComplaintModal","Admin")',
            saveAssignment: '@Url.Action("SaveAssignment","Admin")'
        };
    </script>
    <script src="~/Content/js/admin-complaints.js?v=3"></script>
}
