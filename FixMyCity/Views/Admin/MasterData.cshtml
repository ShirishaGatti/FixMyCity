@{
    ViewBag.Title = "Master Data";
    ViewBag.ActivePage = "MasterData";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section adminStyles {
    <link href="~/Content/css/MasterData.css" rel="stylesheet" />
}

<div class="md-page">

    <!-- Page header -->
    <div class="md-header mb-4">
        <div>
            <h2 class="md-title">Master Data Management</h2>
            <p class="md-subtitle">Click any category to view and manage its records</p>
        </div>
    </div>

    <!-- 7 Entity Cards -->
    <div class="md-cards-grid" id="mdCards">

        <div class="md-card" id="card-state" data-entity="state" tabindex="0" role="button" aria-expanded="false">
            <div class="md-card-icon" style="background:linear-gradient(135deg,#1574e0,#38bdf8)">
                <i class="bi bi-geo-fill"></i>
            </div>
            <div class="md-card-body">
                <h5>States</h5>
                <p>Manage state records</p>
            </div>
            <i class="bi bi-chevron-right md-card-arrow"></i>
        </div>

        <div class="md-card" id="card-district" data-entity="district" tabindex="0" role="button" aria-expanded="false">
            <div class="md-card-icon" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)">
                <i class="bi bi-map-fill"></i>
            </div>
            <div class="md-card-body">
                <h5>Districts</h5>
                <p>Manage district records</p>
            </div>
            <i class="bi bi-chevron-right md-card-arrow"></i>
        </div>

        <div class="md-card" id="card-city" data-entity="city" tabindex="0" role="button" aria-expanded="false">
            <div class="md-card-icon" style="background:linear-gradient(135deg,#0891b2,#22d3ee)">
                <i class="bi bi-building-fill"></i>
            </div>
            <div class="md-card-body">
                <h5>Cities</h5>
                <p>Manage city records</p>
            </div>
            <i class="bi bi-chevron-right md-card-arrow"></i>
        </div>

        <div class="md-card" id="card-ward" data-entity="ward" tabindex="0" role="button" aria-expanded="false">
            <div class="md-card-icon" style="background:linear-gradient(135deg,#d97706,#fbbf24)">
                <i class="bi bi-signpost-2-fill"></i>
            </div>
            <div class="md-card-body">
                <h5>Wards</h5>
                <p>Manage ward records</p>
            </div>
            <i class="bi bi-chevron-right md-card-arrow"></i>
        </div>

        <div class="md-card" id="card-category" data-entity="category" tabindex="0" role="button" aria-expanded="false">
            <div class="md-card-icon" style="background:linear-gradient(135deg,#059669,#34d399)">
                <i class="bi bi-tags-fill"></i>
            </div>
            <div class="md-card-body">
                <h5>Categories</h5>
                <p>Manage complaint categories</p>
            </div>
            <i class="bi bi-chevron-right md-card-arrow"></i>
        </div>

        <div class="md-card" id="card-department" data-entity="department" tabindex="0" role="button" aria-expanded="false">
            <div class="md-card-icon" style="background:linear-gradient(135deg,#be185d,#f472b6)">
                <i class="bi bi-building-gear"></i>
            </div>
            <div class="md-card-body">
                <h5>Departments</h5>
                <p>Manage department records</p>
            </div>
            <i class="bi bi-chevron-right md-card-arrow"></i>
        </div>

        <div class="md-card" id="card-role" data-entity="role" tabindex="0" role="button" aria-expanded="false">
            <div class="md-card-icon" style="background:linear-gradient(135deg,#dc2626,#f87171)">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div class="md-card-body">
                <h5>Roles</h5>
                <p>Manage system roles</p>
            </div>
            <i class="bi bi-chevron-right md-card-arrow"></i>
        </div>

    </div><!-- /md-cards-grid -->

    <!-- Slide-in Data Panel (shown below cards) -->
    <div class="md-panel" id="mdPanel" style="display:none" aria-live="polite">
        <!-- Panel header -->
        <div class="md-panel-header">
            <div class="d-flex align-items-center gap-3">
                <div class="md-panel-icon" id="mdPanelIcon"></div>
                <div>
                    <h4 class="mb-0" id="mdPanelTitle">Entity</h4>
                    <small class="text-muted" id="mdPanelSubtitle"></small>
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn md-btn-add" id="btnAddRecord">
                    <i class="bi bi-plus-lg me-1"></i> Add New
                </button>
                <button type="button" class="md-panel-close" id="btnClosePanel" title="Close panel">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <!-- Panel body: data table -->
        <div class="md-panel-body" id="mdPanelBody">
            <div class="md-loading">
                <div class="md-spinner"></div>
                <span>Loading records...</span>
            </div>
        </div>
    </div><!-- /md-panel -->

</div><!-- /md-page -->

<!-- ── Add / Edit Modal ─────────────────────────────────────────── -->
<div class="modal fade" id="masterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content md-modal-content">
            <form id="masterForm">
                @Html.AntiForgeryToken()
                <div class="modal-header md-modal-header">
                    <h5 class="modal-title" id="masterModalTitle">Add</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body md-modal-body">
                    <div id="masterFormError" class="md-form-error" style="display:none"></div>

                    <input type="hidden" id="mId"         name="Id"         value="0" />
                    <input type="hidden" id="mEntityType" name="EntityType" value="" />
                    
                    <div class="mb-3" id="mParentGroup" style="display:none;">
                        <label for="mParentId" id="mParentLabel" class="form-label md-label">Parent</label>
                        <select class="form-select md-input" id="mParentId" name="ParentId"></select>
                    </div>
                    <div class="mb-3">
                        <label for="mName" class="form-label md-label">Name</label>
                        <input type="text" class="form-control md-input" id="mName" name="Name" maxlength="100" required placeholder="Enter name..." />
                    </div>

                    <div class="mb-3" id="mWardNoGroup" style="display:none;">
                        <label for="mWardNo" class="form-label md-label">Ward No <span class="text-danger">*</span></label>
                        <input type="number" class="form-control md-input" id="mWardNo" name="WardNo" min="1" placeholder="Enter Ward No..." />
                    </div>
                    <div class="mb-3" id="mDepartmentIdGroup" style="display:none;">
                        <label for="mDepartmentId" class="form-label md-label">Department Id<span class="text-danger">*</span></label>
                        <select class="form-select md-input" id="mDepartmentId" name="DepartmentId"></select>
                    </div>
                    <div class="form-check md-check">
                        <input type="checkbox" class="form-check-input" id="mIsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label" for="mIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer md-modal-footer">
                    <button type="button" class="btn md-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn md-btn-save" id="btnSave">
                        <i class="bi bi-check-lg me-1"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast container -->
<div id="mdToastContainer"></div>

@section adminScripts {
    <script src="~/Content/js/MasterData.js"></script>
    <script>
        $(function () {
            MasterData.init({
                urls: {
                    list: '@Url.Action("GetMasterList", "Admin")',
                    save: '@Url.Action("SaveMaster",    "Admin")'
                }
            });
        });
    </script>
}
