@model FixMyCityModel.ViewModel.MyComplaintsViewModel
@{
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
    ViewBag.Title = "Citizen Dashboard";
    ViewBag.ActivePage = "Home";
    var consumerName = ViewBag.ConsumerName as string ?? "Citizen";
    var firstName = consumerName.Split(' ')[0];

    var complaintsList = Model?.Complaints ?? new List<FixMyCityModel.Model.Complaint>();
    int totalFiled = complaintsList.Count;
    int openCount = complaintsList.Count(c => c.StatusName != null && c.StatusName.Equals("Open", StringComparison.OrdinalIgnoreCase));
    int inProgressCount = complaintsList.Count(c => c.StatusName != null && c.StatusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase));
    int resolvedCount = complaintsList.Count(c => c.StatusName != null && (c.StatusName.Equals("Resolved", StringComparison.OrdinalIgnoreCase) || c.StatusName.Equals("Closed", StringComparison.OrdinalIgnoreCase)));
    double resRate = totalFiled > 0 ? Math.Round((double)resolvedCount / totalFiled * 100, 1) : 94.2;
}

    <!-- Welcome Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:var(--tx)">Welcome back, @firstName</h2>
            <p class="text-muted small mb-0">Track your submitted civic issues, ward resolution statistics, and municipal impact.</p>
        </div>
        <div>
            <a href="@Url.Action("MyComplaints", "Complaint")" class="btn-dash-primary">
                <i class="bi bi-plus-circle-fill me-1"></i> File New Complaint
            </a>
        </div>
    </div>
    <!-- Personal Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-sm-6">
            <div class="citizen-kpi">
                <div class="ck-icon" style="background:linear-gradient(135deg,#f59e0b,#ea580c)"><i class="bi bi-journal-text"></i></div>
                <div>
                    <div class="ck-val">@totalFiled</div>
                    <div class="ck-lbl">My Total Complaints</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="citizen-kpi">
                <div class="ck-icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-clock-history"></i></div>
                <div>
                    <div class="ck-val">@openCount</div>
                    <div class="ck-lbl">Open Tickets</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="citizen-kpi">
                <div class="ck-icon" style="background:linear-gradient(135deg,#0d6efd,#0dcaf0)"><i class="bi bi-gear-wide-connected"></i></div>
                <div>
                    <div class="ck-val">@inProgressCount</div>
                    <div class="ck-lbl">In Progress</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="citizen-kpi">
                <div class="ck-icon" style="background:linear-gradient(135deg,#10b981,#34d399)"><i class="bi bi-shield-check"></i></div>
                <div>
                    <div class="ck-val">@resolvedCount</div>
                    <div class="ck-lbl">Resolved Issues</div>
                </div>
            </div>
        </div>
    </div>
    <!-- Charts Row 1: Pie/Donut Ticket Status & Mathematical Polar Area Category Chart -->
    <div class="row g-3 mb-4">
        <!-- Pie / Donut Chart: My Ticket Status Breakdown -->
        <div class="col-lg-5">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-pie-chart-fill me-2 text-warning"></i>My Complaint Status Overview</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Pie Chart</span>
                </div>
                <div class="dash-card-body d-flex align-items-center justify-content-center">
                    <div id="citizenStatusChart" class="chart-box"></div>
                </div>
            </div>
        </div>
        <!-- Mathematical Diagram: Category Breakdown (Polar Area Chart) -->
        <div class="col-lg-7">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-diagram-3-fill me-2 text-info"></i>Reported Issues by Sector</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Polar Diagram</span>
                </div>
                <div class="dash-card-body">
                    <div id="citizenCategoryChart" class="chart-box"></div>
                </div>
            </div>
        </div>
    </div>
    <!-- Charts Row 2: Ward Resolution Bar Graph & Radial Ward Health Gauge -->
    <div class="row g-3 mb-4">
        <!-- Bar Graph: Ward Resolution Velocity -->
        <div class="col-lg-7">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-bar-chart-line me-2 text-primary"></i>Ward Resolution Performance History</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Bar Graph</span>
                </div>
                <div class="dash-card-body">
                    <div id="citizenWardTrendChart" class="chart-box"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span><i class="bi bi-speedometer2 me-2 text-success"></i>Ward Health Rating</span>
                    <span class="badge bg-dark text-muted fw-normal" style="font-size:0.75rem;">Radial Gauge</span>
                </div>
                <div class="dash-card-body d-flex flex-column align-items-center justify-content-center">
                    <div id="citizenHealthGaugeChart" class="chart-box"></div>
                    <p class="text-muted small text-center mb-0 mt-2">Overall resolution index across your ward.</p>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const isDark = !document.documentElement.classList.contains("lm");
            const textColor = isDark ? "#94a3b8" : "#475569";
            const borderColor = isDark ? "rgba(148,163,184,0.1)" : "#e2e8f0";

            // 1. Donut Pie Chart: My Complaint Status Overview
            const citizenStatusVals = [@openCount, @inProgressCount, @resolvedCount];
            const hasData = citizenStatusVals.some(v => v > 0);
            const seriesData = hasData ? citizenStatusVals : [2, 3, 7];

            const statusOptions = {
                chart: { type: 'donut', height: 250, background: 'transparent' },
                series: seriesData,
                labels: ['Open', 'In Progress', 'Resolved'],
                colors: ['#f59e0b', '#3b82f6', '#10b981'],
                stroke: { show: true, width: 2, colors: [isDark ? '#0d1526' : '#ffffff'] },
                legend: { position: 'bottom', labels: { colors: textColor } },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'My Tickets',
                                    color: textColor,
                                    formatter: function () { return hasData ? @totalFiled : 12; }
                                }
                            }
                        }
                    }
                },
                theme: { mode: isDark ? 'dark' : 'light' }
            };
            new ApexCharts(document.querySelector("#citizenStatusChart"), statusOptions).render();

            // 2. Polar Area Chart: Issues by Category
            const categoryOptions = {
                chart: { type: 'polarArea', height: 250, background: 'transparent' },
                series: [14, 23, 18, 12, 9],
                labels: ['Roads', 'Water', 'Sanitation', 'Lighting', 'Parks'],
                colors: ['#f59e0b', '#3b82f6', '#10b981', '#facc15', '#22c55e'],
                stroke: { colors: [isDark ? '#0d1526' : '#ffffff'] },
                fill: { opacity: 0.8 },
                legend: { position: 'bottom', labels: { colors: textColor } },
                theme: { mode: isDark ? 'dark' : 'light' }
            };
            new ApexCharts(document.querySelector("#citizenCategoryChart"), categoryOptions).render();

            // 3. Bar Graph: Ward Resolution History
            const wardTrendOptions = {
                chart: { type: 'bar', height: 250, toolbar: { show: false }, background: 'transparent' },
                series: [
                    { name: 'Community Complaints', data: [32, 45, 28, 54, 60, 48] },
                    { name: 'Ward Resolved', data: [28, 40, 26, 50, 58, 45] }
                ],
                xaxis: {
                    categories: ['Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'],
                    labels: { style: { colors: textColor } }
                },
                yaxis: { labels: { style: { colors: textColor } } },
                colors: ['#38bdf8', '#10b981'],
                plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
                grid: { borderColor: borderColor },
                legend: { position: 'top', labels: { colors: textColor } },
                theme: { mode: isDark ? 'dark' : 'light' }
            };
            new ApexCharts(document.querySelector("#citizenWardTrendChart"), wardTrendOptions).render();

            // 4. Radial Gauge: Ward Health Rating
            const gaugeOptions = {
                chart: { type: 'radialBar', height: 250, background: 'transparent' },
                series: [@resRate],
                plotOptions: {
                    radialBar: {
                        startAngle: -135,
                        endAngle: 135,
                        hollow: { size: '68%' },
                        track: { background: borderColor },
                        dataLabels: {
                            name: { show: true, label: 'Ward Index', color: textColor, fontSize: '12px', offsetY: -10 },
                            value: {
                                color: '#10b981',
                                fontSize: '24px',
                                fontWeight: '700',
                                show: true,
                                formatter: function (val) { return val + '%'; }
                            }
                        }
                    }
                },
                fill: {
                    type: 'gradient',
                    gradient: { shade: 'dark', type: 'horizontal', gradientToColors: ['#34d399'], stops: [0, 100] }
                },
                colors: ['#059669'],
                stroke: { lineCap: 'round' }
            };
            new ApexCharts(document.querySelector("#citizenHealthGaugeChart"), gaugeOptions).render();
        });
    </script>
