<?xml version="1.0"?>
<configuration>
  <configSections>
    <!--<section name="entityFramework"
      type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
      requirePermission="false" />-->
    <section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
  </configSections>
  <dataConfiguration defaultDatabase="constr"/>
  <connectionStrings>
    <add name="constr" providerName="System.Data.SqlClient" connectionString="Data Source=VPNSERVER1\SQLEXPRESS;Initial Catalog=Training_DB_Shirisha_Gatti;User ID=Training_DB_Shirisha_Gatti;Password=Training_DB_Shirisha_Gatti"/>
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <add key="JwtSecretKey" value="F$k9#mQ2@nR7vX4!pL8wZ3^hY6tA1sD0!"/>
    <add key="JwtExpiryMinutes" value="15"/>
    <add key="JwtRefreshExpiryDays" value="7"/>
    <add key="SmtpEmail" value="shirishagatti99@gmail.com"/>
    <add key="SmtpPassword" value="uilf gdap njne ersi"/>
    <!-- inside <appSettings> -->
    <add key="AttachmentUploadRoot" value="~/App_Data/Uploads/Complaints"/>
    <add key="MaxAttachmentSizeMB" value="5"/>
    <add key="AllowedAttachmentExtensions" value=".jpg,.jpeg,.png,.pdf,.doc,.docx"/>
  <add key="ChatAttachmentUploadRoot" value="~/App_Data/Uploads/ComplaintChat" />
<add key="ChatAllowedAttachmentExtensions" value=".jpg,.jpeg,.png,.pdf,.doc,.docx" />
<add key="ChatMaxAttachmentSizeMB" value="5" />
  </appSettings>
  <!-- ONLY ONE system.web -->
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <customErrors mode="off" defaultRedirect="~/Error/General">
      <error statusCode="404" redirect="~/Error/NotFound"/>
      <error statusCode="500" redirect="~/Error/General"/>
    </customErrors>
    <authentication mode="None"/>
    <compilation debug="true" targetFramework="4.8"/>
    <!--<httpRuntime targetFramework="4.5.2"/>-->
    <httpRuntime targetFramework="4.5.2" maxRequestLength="20480" executionTimeout="120"/>
    <httpModules>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"/>
    </httpModules>
  </system.web>
  <!-- ONLY ONE system.webServer -->
  <system.webServer>
    <modules>
      <remove name="FormsAuthentication"/>
      <remove name="ApplicationInsightsWebTracking"/>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" preCondition="managedHandler"/>
    </modules>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404"/>
      <error statusCode="404" path="/Error/NotFound" responseMode="ExecuteURL"/>
      <remove statusCode="500"/>
      <error statusCode="500" path="/Error/General" responseMode="ExecuteURL"/>
    </httpErrors>
    <validation validateIntegratedModeConfiguration="false"/>
    <!-- add inside <system.webServer> -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520"/>
      </requestFiltering>
    </security>
  </system.webServer>
  <!-- KEEP YOUR EXISTING runtime SECTION HERE -->
